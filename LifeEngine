def get_rank(points):
    # Les 40 niveaux de classement global (Régularité)
    ranks = [
        (0, "Fer IV"), (100, "Fer III"), (200, "Fer II"), (300, "Fer I"),
        (400, "Bronze IV"), (500, "Bronze III"), (600, "Bronze II"), (800, "Bronze I"),
        (1000, "Argent IV"), (1200, "Argent III"), (1400, "Argent II"), (1700, "Argent I"),
        (2000, "Or IV"), (2400, "Or III"), (2800, "Or II"), (3300, "Or I"),
        (3800, "Platine IV"), (4400, "Platine III"), (5000, "Platine II"), (5800, "Platine I"),
        (6600, "Émeraude IV"), (7500, "Émeraude III"), (8500, "Émeraude II"), (9600, "Émeraude I"),
        (11000, "Diamant IV"), (12500, "Diamant III"), (14500, "Diamant II"), (17000, "Diamant I"),
        (20000, "Maître IV"), (23000, "Maître III"), (26000, "Maître II"), (30000, "Maître I"),
        (35000, "Grand Maître IV"), (40000, "Grand Maître III"), (46000, "Grand Maître II"), (53000, "Grand Maître I"),
        (60000, "Challenger IV"), (70000, "Challenger III"), (85000, "Challenger II"), (100000, "Challenger I")
    ]
    for i in range(len(ranks)):
        if points < ranks[i][0]: 
            return ranks[i-1][1], ranks[i][0]
    return ranks[-1][1], points

def get_muscle_color(weight, muscle_zone):
    """Détermine la couleur du muscle sur le bodygraph en fonction du poids max (PR)"""
    if weight <= 0: 
        return "#e2e8f0" # Non entraîné (Gris clair)
        
    heavy_tiers = [20, 40, 60, 80, 100, 120, 140, 160] 
    medium_tiers = [15, 30, 45, 60, 75, 90, 105, 120] 
    small_tiers = [6, 12, 18, 24, 30, 36, 42, 50] 
    
    tiers = heavy_tiers if muscle_zone in ["Quadriceps", "Ischio-jambiers", "Fessiers", "Lombaires", "Pecs Milieu"] else (medium_tiers if muscle_zone in ["Pecs Haut", "Pecs Bas", "Grand Dorsal", "Trapèzes", "Épaules (Avant)"] else small_tiers)
    
    if weight < tiers[1]: return "#94a3b8" # Fer
    elif weight < tiers[2]: return "#b45309" # Bronze
    elif weight < tiers[3]: return "#94a3b8" # Argent
    elif weight < tiers[4]: return "#fbbf24" # Or
    elif weight < tiers[5]: return "#2dd4bf" # Platine
    elif weight < tiers[6]: return "#34d399" # Émeraude
    elif weight < tiers[7]: return "#60a5fa" # Diamant
    else: return "#f43f5e" # Master/Challenger

